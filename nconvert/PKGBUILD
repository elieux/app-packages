_realname=nconvert
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=7.300
pkgrel=1
pkgdesc="A powerful command line multi-platform batch image processor"
url="https://www.xnview.com/en/nconvert/"
arch=('any')
license=('custom')
makedepends=()
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("NConvert-win64-unicode.zip::https://download.xnview.com/old_versions/NConvert/NConvert-${pkgver}-win64-unicode.zip")
sha512sums=('2f4eec51e9c3726cf9e149bf02c7ecf2429b4cf6f00fd9de2979bd702fc406425c74da475768809642384ed3c49bca056ac1ce50e4dea0f1c5a75e05914e7ed4')
noextract=()

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "NConvert"/* "${a}"
    _rmmsdll "${a}"
}
