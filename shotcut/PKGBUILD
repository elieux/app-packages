provides=()
options=(!strip)
source=("shotcut-win64.zip::https://github.com/mltframework/shotcut/releases/download/v${pkgver}/shotcut-win64-${pkgver}.zip")
sha512sums=('baae520c89c4747fa61adf5e7591ad7aa5ec1a27b86e31acf809abe673bf64dfcbb274c8c69521bf6e80354aac3df680f70a21cb06a2bb8920c5af1ce6e9ecae')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
