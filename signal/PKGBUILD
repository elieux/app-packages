# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=signal
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=8.32.0
pkgrel=1
pkgdesc="Desktop Signal client"
url="https://www.signal.org/download/windows/"
arch=('any')
license=('GPL3')
makedepends=("p7zip")
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("signal-desktop-win.exe::https://updates.signal.org/desktop/signal-desktop-win-${pkgver}.exe")
sha512sums=('d42349b54b0bcb83b43731dd852892d96a72614adb32a764f420063c9fd0517cabbeb99984731a4b66256b41450d7cde09ef061de8fced42ad5e3551cc5fc00f')
noextract=("signal-desktop-win.exe")

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

prepare() {
    rm -fR "signal-desktop-win.dir"
    7z x -y -bd "signal-desktop-win.exe" -o"signal-desktop-win.dir" > /dev/null
    7z x -y -bd "signal-desktop-win.dir"/'$PLUGINSDIR'/"app-64.7z" -o"app-64" > /dev/null
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "app-64"/* "${a}"
    _rmmsdll "${a}"
}
