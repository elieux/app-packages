# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=slack
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=4.53.287
pkgrel=1
pkgdesc="Client for the Slack team communication platform"
url="https://www.slack.com/"
arch=('any')
license=('custom')
makedepends=("unzip")
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("Slack.msix::https://downloads.slack-edge.com/desktop-releases/windows/x64/${pkgver}/Slack.msix")
sha512sums=('6fd41c938aab32dfc84dca4106aa90207f9dd64b427e29b5ee23af443986c8284403c4c1be9bc318b2d9e03f751e8484da45b04ab14ee84196a93013c251fc80')
noextract=("Slack.msix")

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

prepare() {
    unzip -q -o "Slack.msix"
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "app"/* "${a}"
    _rmmsdll "${a}"
}
