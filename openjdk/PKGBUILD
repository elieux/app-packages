_realname=openjdk
_realver=c3a705caf5044be8aa0b09e62be69b20/4
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=27.0.1.1
pkgrel=1
pkgdesc="Open Java Development Kit"
url="https://openjdk.org/"
arch=('any')
license=('custom')
makedepends=()
replaces=("app-x86_64-${_realname}" "app-i686-jdk" "app-x86_64-jdk")
conflicts=("app-x86_64-${_realname}" "app-i686-jdk" "app-x86_64-jdk")
provides=()
options=(!strip)
source=("openjdk_windows-x64_bin.zip::https://download.java.net/java/GA/jdk${pkgver%.0.0}/${_realver}/GPL/openjdk-${pkgver%.0.0}_windows-x64_bin.zip")
sha512sums=('a7dc6355bc5fa5763762c87bb2a1f21b42f7bae4d12bf4b68e69d3c3a57c48df86c9291e961761ef1c342d1d63cfad8480838064ce8e2b56e8aaae9ef29a8be0')
noextract=()

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "jdk-${pkgver%.0.0}"/* "${a}"
    _rmmsdll "${a}"
}
