_realname=composer
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=2.11.3
pkgrel=1
pkgdesc="A dependency manager for PHP"
url="https://getcomposer.org/"
arch=('any')
license=('MIT')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("composer.phar::https://github.com/composer/composer/releases/download/${pkgver}/composer.phar")
sha512sums=('35974b694dc3fad716bd0ffaf00e2b567bcf9595ce9944d845cbd02f408d683ac3d07ff56278aa13858b2f14296eae568154257c8a986905bb182ba2837acdef')
noextract=("composer.phar")

package() {
    depends=("app-php")

    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp "composer.phar" "${a}"
}
