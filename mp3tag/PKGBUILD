# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=mp3tag
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=3.37
pkgrel=1
pkgdesc="Powerful audio metadata editor"
url="https://mp3tag.de/en/index.html"
arch=('any')
license=('custom')
makedepends=("p7zip")
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("mp3tag-x64-setup.exe::https://download.mp3tag.de/mp3tag-v${pkgver}-x64-setup.exe")
sha512sums=('3e4ab57a5b5039a53443bfe8c2665bd8a32f9ff0459e821bbb59cb8e5a1c24223daeb02cf86bfd1a203478c5bd52d2cb029b984ce5a6e03eb949735b72080892')
noextract=("mp3tag-x64-setup.exe")

prepare() {
    local w f
    w="*license*.txt"
    7z x -y -bd -x!"${w}" "mp3tag-x64-setup.exe" -o"mp3tag-x64-setup.dir" > /dev/null
    for f in $(7z l -y -bd -i!"${w}" "mp3tag-x64-setup.exe" | grep 'license.*txt' | sed -r 's/[ ]+/\t/g' | cut -f 5 | sed 's/^.*\\//')
    do
        7z e -y -bd -so -i!"*${f}" "mp3tag-x64-setup.exe" > "mp3tag-x64-setup.dir/${f}"
    done
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}" "${a}/help"
    cp -R "mp3tag-x64-setup.dir"/* "${a}"
    touch "${a}/help/helpmap.idx"
    rm -R "${a}"/'$PLUGINSDIR' "${a}"/'$R0' "${a}"/'$R2'
}
