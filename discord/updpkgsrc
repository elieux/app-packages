#!/usr/bin/env php
<?php
// no error handling yet

$pkgbuild = file_get_contents('PKGBUILD');
preg_match('~^pkgver=([0-9.]+)$~m', $pkgbuild, $match);
$pkgver = $match[1];

$manifest = json_decode(file_get_contents("https://discord.com/api/updates/distributions/app/manifests/latest?channel=stable&platform=win&arch=x64"));
$newpkgver = implode('.', $manifest->full->host_version);
$srclist = [];
$srclist[] = "discord.tar.br::{$manifest->full->url}";
foreach ($manifest->modules as $name => $module) {
    $srclist[] = "{$name}-{$module->full->module_version}.tar.br::{$module->full->url}";
}
sort($srclist);

$pkgbuild = preg_replace("~pkgver=[0-9.]+~", "pkgver={$newpkgver}", $pkgbuild);
$source = ltrim(implode("\n", array_map(function($src) use($newpkgver) { return '        "' . str_replace($newpkgver, '${pkgver}', $src) . '"'; }, $srclist)));
$pkgbuild = preg_replace("~source=\(.*?\)~s", "source=({$source})", $pkgbuild);
$noextract = ltrim(implode("\n", array_map(function($src) use($newpkgver) { return '           "' . explode('::', $src)[0] . '"'; }, $srclist)));
$pkgbuild = preg_replace("~noextract=\(.*?\)~s", "noextract=({$noextract})", $pkgbuild);
rename('PKGBUILD', 'PKGBUILD.old');
file_put_contents('PKGBUILD', $pkgbuild);
