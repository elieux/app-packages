_chocover() {
    # 4.8.10.230802 -> 4.8.10
    echo "${1}" | sed -r 's/^([0-9]+)[.]([0-9]+)[.]([0-9]+)[.]([0-9]{6})$/\1.\2.\3/'
}

_realname=telegram
_choconame=telegram
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=7.3.1
pkgrel=1
pkgdesc="Desktop Telegram client"
url="https://desktop.telegram.org/"
arch=('any')
license=('GPL3')
replaces=("app-i686-${_realname}")
provides=("${pkgbase}")
options=(!strip)
source=("td-portable-win-x64.zip::https://github.com/telegramdesktop/tdesktop/releases/download/v${pkgver}/td-portable-win-x64-${pkgver}.zip")
sha512sums=('67c0e3465f53981bac50d5fa5d7d11392b430a9440eb1f3a647bcd15784a6bb97b9bc0d7ad1bed42b79be1194c86cb8e9160e2ac38a799712a790f2ac061e809')

_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "Telegram"/* "${a}"
    _lc "${a}"/*
}
