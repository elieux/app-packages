# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=viber
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=29.5.0.0
pkgrel=1
pkgdesc="Free messages and calls in any country"
url="https://www.viber.com/download/"
arch=('any')
license=('custom')
makedepends=("app-lessmsi")
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("ViberSetup.msi::https://download.cdn.viber.com/desktop/windows/${pkgver/.0.0/.0}/ViberSetup.msi")
sha512sums=('6f7e17a78e80df16d899304de8bea9d1f55241c75bbdbfd4e841a7855301481c98756516c5cb133e7e1484505e3e22d575c5e2c6259fac5437c2b3758e68970d')
noextract=("ViberSetup.msi")

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

prepare() {
    /apps/lessmsi/lessmsi x "ViberSetup.msi" > /dev/null
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "ViberSetup/SourceDir/LocalApp/Viber"/* "${a}"
    _rmmsdll "${a}"
}
