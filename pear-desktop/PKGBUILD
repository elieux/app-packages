_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=pear-desktop
_choconame=pear-desktop
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=3.12.0
pkgrel=1
pkgdesc="Music app with extensions"
url="https://th-ch.github.io/youtube-music/"
arch=('any')
license=('MIT')
replaces=('app-x86_64-youtube-music')
provides=("${pkgbase}")
options=(!strip)
source=("youtube-music-x64.nsis.7z::https@subdir://github.com/pear-devs/pear-desktop/releases/download/v${pkgver}/youtube-music-${pkgver}-x64.nsis.7z")
sha512sums=('0a427561e06e431632db24aa1f49d192f0ac01f320400e98ce048006913e532e44b7204d522bd1b06883ea402285d79147f05fb420a1adfbeb405abe1b3d7eb1')

_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "youtube-music-x64.nsis"/* "${a}"
    mv "${a}/YouTube Music.exe" "${a}/YouTube-Music.exe"
    _lc "${a}"/*
}
