_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

download_http@subdir() {
    download_file "${1/@subdir:/:}"
}

extract_http@subdir() {
    _extract_subdir "${@}"
}

_realname=tmonitor
_dirname=cpuid
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=1.04
pkgrel=1
pkgdesc="Monitors processor performance and other values (CPUID)"
url="https://www.cpuid.com/softwares/tmonitor.html"
arch=('any')
license=('custom')
makedepends=()
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("tmonitor.zip::http@subdir://download.cpuid.com/tmonitor/tmonitor_${pkgver}.zip")
sha512sums=('58a0e7b7afd9dd810308c16a58eb13f79f3cdf8ec3e2f3be227d57a33c45a4554234f922dd17bd674c444cc949f3ca3d734e791145c9a8396d2e252c06392e25')
noextract=()

package() {
    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}"
    cp "tmonitor"/* "${a}"
    rm "${a}/TMonitor_x32.exe"
    mv "${a}/TMonitor_x64.exe" "${a}/TMonitor.exe"
}
