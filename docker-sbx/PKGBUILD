# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=docker-sbx
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=0.54.1
pkgrel=1
pkgdesc="Run AI coding agents in isolated environments"
url="https://docs.docker.com/ai/sandboxes/"
arch=('any')
license=('custom')
makedepends=("app-lessmsi")
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("DockerSandboxes.msi::https://github.com/docker/sbx-releases/releases/download/v${pkgver}/DockerSandboxes.msi")
sha512sums=('04e722c6fc78007d6db304ac24cb65717ce9559d281535fe0475efabe67d1287758054e42422e297e83e818452ba9645d27d391c265fc503b59e927bd1b9e342')
noextract=("DockerSandboxes.msi")

prepare() {
    rm -fR "DockerSandboxes"
    /apps/lessmsi/lessmsi x "DockerSandboxes.msi" > /dev/null
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "DockerSandboxes/SourceDir/LocalApp/DockerSandboxes"/* "${a}"
}
