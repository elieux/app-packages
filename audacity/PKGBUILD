# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=audacity
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=4.0.1
pkgrel=1
pkgdesc="Audio editor"
url="https://www.audacityteam.org/"
arch=('any')
license=('GPL3')
provides=("${pkgbase}")
options=(!strip)
source=("audacity-win-x86_64.7z::https://github.com/audacity/audacity/releases/download/Audacity-${pkgver}/audacity-win-${pkgver}-x86_64.7z")
sha512sums=('ef4b138cb456508f3d4b492296c10f64b20f4f0ae7e83634bd6d844ce0fdc15039d53a539e6459e55ec5e84dd5bb4e81b8921a4205c928a521302415231e93f1')

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "Audacity-${pkgver}".*-x86_64/* "${a}"
    _rmmsdll "${a}"
}
