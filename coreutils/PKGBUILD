# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=coreutils
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=2026.9.3
pkgrel=1
pkgdesc="UNIX-style core utilities for Windows"
arch=('any')
url="https://github.com/microsoft/coreutils"
license=('MIT')
makedepends=("app-innounp")
provides=("${pkgbase}")
options=(!strip)
source=("coreutils-x64.exe::https://github.com/microsoft/coreutils/releases/download/v${pkgver}/coreutils-${pkgver}-x64.exe")
sha512sums=('72a30de0623049b33d858b8350052de63047c49f7bc7316ad8bb78c594b306ff781aa65b75906bf3395966c5ff69016b9ed814c43caafd6a29d2b5907779816a')
noextract=("coreutils-x64.exe")

prepare() {
    /apps/innounp/innounp -x -q -m -a -y "coreutils-x64.exe" -d"coreutils-x64.dir"
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "coreutils-x64.dir/{app}"/* "${a}"
    local -a cmds
    cmds=($(cat "${a}/pwsh-install-template.ps1" | sed -nr '/__COREUTILS__ = /,/^[)]$/p' | tail -n+3 | head -n-3 | tr -d "\n,'"))
    local cmd
    for cmd in "${cmds[@]}"
    do
        if test "${cmd}" != "ln"
        then
            ln "${a}/coreutils.exe" "${a}/bin/${cmd}.exe"
            ln "${a}/coreutils.exe" "${a}/cmd/${cmd}.cmd"
        fi
    done
}
