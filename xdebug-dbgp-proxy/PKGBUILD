# Maintainer: David Macek <david.macek.0@gmail.com>

_dirname=xdebug-dbgp-tools
_realname=xdebug-dbgp-proxy
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=0.6.2 # determined by running the .exe
pkgrel=1
pkgdesc="DBGp proxy from Xdebug"
url="https://xdebug.org/docs/dbgpProxy"
arch=('any')
license=('unknown')
conflicts=("xdebug-dbgp-tools")
provides=("${pkgbase}")
options=(!strip)
source=("dbgpProxy.exe::https://xdebug.org/files/binaries/dbgpProxy.exe")
sha512sums=('40bb8011b98a16fd6bae1822e0fed97082ea1bc7a15f7e460efbf07c98dd0f4a84369e2c42e057a5364d118c8e980b01cd497096fb4a6e524588fdca5d8b73f7')

_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

package() {
    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}"
    cp "dbgpProxy.exe" "${a}"
    _lc "${a}"/*
}
