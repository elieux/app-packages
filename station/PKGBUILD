_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=station
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=4.0.0
pkgrel=1
pkgdesc="First open-source smart browser for busy people. A single place for all of your web applications."
url="https://getstation.com/"
arch=('any')
license=('Apache-2.0')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("Station-win-x64.zip::https@subdir://github.com/getstation/desktop-app/releases/download/v${pkgver}/Station-v${pkgver}-win-x64.zip")
sha512sums=('56e1abd4dbe1a4fc50f5094cab68254f777eece3e2b1771ed4b7854da657a1adaa1177872ce7b9b288943de6b486d4d3745abfecbae91b8cdcdb2adf2de3e94f')
noextract=()

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "Station-win-x64"/* "${a}"
    _rmmsdll "${a}"
}
