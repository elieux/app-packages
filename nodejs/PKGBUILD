_realname=nodejs
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=26.12.1
pkgrel=1
pkgdesc="Evented I/O for V8 javascript"
url="https://nodejs.org/"
arch=('any')
license=('MIT')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("node-win-x64.zip::https://nodejs.org/dist/v${pkgver}/node-v${pkgver}-win-x64.zip")
sha512sums=('6aa329313319307bf5bc75541607a84dca68b6e15c5416ca11542aaf46e3553ec856c626de9c253edffa75b2f16c653297850b11db0a91e4b8e8cd6bb496b6c2')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "node-v${pkgver}-win-x64"/* "${a}"
}
