# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=salamander-plugin-certview
_dirname=salamander
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=1.3
pkgrel=1
pkgdesc="Certificate viewer plugin for Altap Salamander"
url="https://github.com/lejcik/certviewer"
arch=('any')
license=('custom')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("certview-x64.zip::https://github.com/lejcik/certviewer/releases/download/v${pkgver}/certview-x64.zip")
sha512sums=('d9f95ab2e89e8c658735a491279407f3a627bd0ec452df50cdf346d0fab0117749e5f2261c79ce401f508fb5837688338395e6c7228b6d32bba2aea3a2d0aef7')
noextract=()

package() {
    depends=("app-salamander")

    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}/plugins/certview"
    cp -R "certview-x64"/* "${a}/plugins/certview"
}
