# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=nginx
pkgbase="app-${_realname}"
pkgname=("app-i686-${_realname}")
epoch=1
pkgver=1.31.8
pkgrel=1
pkgdesc="Lightweight HTTP server and IMAP/POP3 proxy server"
url="https://nginx.org/"
arch=('any')
license=('custom')
provides=("${pkgbase}")
options=(!strip)
source=("nginx.zip::https://nginx.org/download/nginx-${pkgver}.zip")
sha512sums=('12ff367208206b270e6e0ffdc979b6625502b3537613a1f8f6b2aa61ff0cbbc81682cb16de9c2329fd4d1062a60aec6ceeacee5c3bfbdd79d14c94eebd017dbd')

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "nginx-${pkgver}"/* "${a}"
    rm -R "${a}"/{logs,temp}
}
