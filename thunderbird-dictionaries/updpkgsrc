#!/usr/bin/env php
<?php
// no error handling yet

$url = "https://addons.thunderbird.net/api/v3/addons/search/?app=firefox&type=dictionary&page_size=50";
$srclist = [];
while ($url) {
	$list = json_decode(file_get_contents($url));
	$url = $list->next;
	foreach ($list->results as $addon) {
		$addonname = trim(preg_replace("~[^a-z0-9_-]~i", '', transliterator_transliterate('Latin', $addon->slug)), '-_');
		echo "Found: {$addonname}-{$addon->id}.xpi\n";
		$srclist[] = "{$addonname}-{$addon->id}.xpi::https@subdir://addons.thunderbird.net/thunderbird/downloads/latest/{$addon->id}/addon-{$addon->id}-latest.xpi";
	}
}

sort($srclist);
$pkgbuild = file_get_contents('PKGBUILD');
$source = ltrim(implode("\n", array_map(function($src) { return "        \"{$src}\""; }, $srclist)));
$pkgbuild = preg_replace("~source=\(.*?\)~s", "source=({$source})", $pkgbuild);
$noextract = ltrim(implode("\n", array_map(function($src) { return '           "' . explode('::', $src)[0] . '"'; }, $srclist)));
$pkgbuild = preg_replace("~noextract=\(.*?\)~s", "noextract=({$noextract})", $pkgbuild);
rename('PKGBUILD', 'PKGBUILD.old');
file_put_contents('PKGBUILD', $pkgbuild);
