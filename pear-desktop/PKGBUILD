_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=pear-desktop
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=3.12.1
pkgrel=1
pkgdesc="Music app with extensions"
url="https://th-ch.github.io/youtube-music/"
arch=('any')
license=('MIT')
makedepends=()
replaces=("app-x86_64-${_realname}" 'app-x86_64-youtube-music')
conflicts=("app-x86_64-${_realname}" 'app-x86_64-youtube-music')
provides=()
options=(!strip)
source=("youtube-music-x64.nsis.7z::https@subdir://github.com/pear-devs/pear-desktop/releases/download/v${pkgver}/youtube-music-${pkgver}-x64.nsis.7z")
sha512sums=('c1e40b6f2aa26262e46a28ac7ce1ce78448f34a362856b505cb866aca70f303b22b4e47d1ec90c8318ba0c64c6a532280cedaf8288a236d2d3c5eb75af9ebe03')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "youtube-music-x64.nsis"/* "${a}"
    mv "${a}/YouTube Music.exe" "${a}/YouTube-Music.exe"
}
