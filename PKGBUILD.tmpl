_realname=<customize>
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=<customize>
pkgrel=1
pkgdesc="<customize>"
url="<customize>"
arch=('any')
license=('<customize>')
makedepends=()
replaces=()
conflicts=()
provides=()
options=(!strip)
source=("<customize>::<customize>")
sha512sums=('<customize>')
noextract=()


package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "<customize>"/* "${a}"
}
