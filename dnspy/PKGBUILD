_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=dnspy
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=6.1.8
pkgrel=2
pkgdesc=".NET debugger and assembly editor"
url="https://github.com/dnSpy/dnSpy"
arch=('any')
license=('GPL3')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("dnSpy-netframework.zip::https@subdir://github.com/dnSpy/dnSpy/releases/download/v${pkgver}/dnSpy-netframework.zip")
sha512sums=('586148b152d7f692929294a1fb2bf942e989c757a9fe596e90b4c97f79ac000e4a404d628f0f4eccf916ea30e4471c86e0d558b1a0dc7f0052be38b9aff3cb9d')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "dnSpy-netframework"/* "${a}"
}
