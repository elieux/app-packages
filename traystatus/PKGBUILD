_realname=traystatus
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=5.2.1
pkgrel=1
pkgdesc="Show status of Caps Lock, Num Lock, Scroll Lock, and more in system tray"
url="https://www.traystatus.com/"
arch=('any')
license=('custom')
replaces=("app-i686-${_realname}")
provides=("${pkgbase}")
options=(!strip)
source=("TrayStatus-x64.zip::https://binaryfortressdownloads.com/Download/BFSFiles/114/TrayStatus-${pkgver}-x64.zip")
sha512sums=('eca8ea2b6861addd8b95608d51019f9ebf7000d111895d638628889b0cb22136b42102b14fb9c9cd08307686ad55cb28fbc8bee8c6bd6c8e88dc37354ae340f9')

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "TrayStatus64"/* "${a}"
}
