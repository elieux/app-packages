_realname=docker-plugin-compose
_dirname=docker
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=5.8.0
pkgrel=1
pkgdesc="Define and run multi-container applications with Docker"
url="https://docs.docker.com/compose/"
arch=('any')
license=('Apache')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("docker-compose-windows-x86_64.exe::https://github.com/docker/compose/releases/download/v${pkgver}/docker-compose-windows-x86_64.exe")
sha512sums=('e76b3f036ab80e6c311541ee7a8d008ee39aee1c89332012c9d002d9e3202e39cf89a61afddfb1cad76e396ad3c028250c614f78dc933d118b5476b65543bd13')
noextract=("docker-compose-windows-x86_64.exe")

package() {
    depends=("app-docker-cli")

    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}/cli-plugins"
    cp "docker-compose-windows-x86_64.exe" "${a}/cli-plugins/docker-compose.exe"
}
