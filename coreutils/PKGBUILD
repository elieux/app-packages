# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=coreutils
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=2026.9.3
pkgrel=2
pkgdesc="UNIX-style core utilities for Windows"
arch=('any')
url="https://github.com/microsoft/coreutils"
license=('MIT')
makedepends=("app-innounp")
provides=("${pkgbase}")
options=(!strip)
source=("coreutils-x64.exe::https://github.com/microsoft/coreutils/releases/download/v${pkgver}/coreutils-${pkgver}-x64.exe")
sha512sums=('72a30de0623049b33d858b8350052de63047c49f7bc7316ad8bb78c594b306ff781aa65b75906bf3395966c5ff69016b9ed814c43caafd6a29d2b5907779816a')
noextract=("coreutils-x64.exe")

prepare() {
    /apps/innounp/innounp -x -q -m -a -y "coreutils-x64.exe" -d"coreutils-x64.dir"
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "coreutils-x64.dir/{app}"/* "${a}"
    local -a cmds
    cmds=(arch b2sum base32 base64 basename basenc cat cksum comm cp csplit cut date df dirname du echo env expr factor false find fmt fold grep head hostname join link ln ls md5sum mkdir mktemp mv nl nproc numfmt od paste pathchk pr printenv printf ptx pwd readlink realpath rm rmdir seq sha1sum sha224sum sha256sum sha384sum sha512sum shuf sleep sort split stat sum tac tail tee test touch tr true truncate tsort unexpand uniq unlink uptime wc xargs yes)
    local cmd
    for cmd in "${cmds[@]}"
    do
        ln "${a}/coreutils.exe" "${a}/bin/${cmd}.exe"
        ln "${a}/coreutils.exe" "${a}/cmd/${cmd}.exe" # ln directly to .cmd creates a .cmd.exe
        mv "${a}/cmd/${cmd}.exe" "${a}/cmd/${cmd}.cmd"
    done
    ln "${a}/coreutils.exe" "${a}/bin/coreutils-manager.exe"
}
