_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

prepare() {
    local d
    for d in *.tar.br
    do
        d="${d%.tar.br}"
        brotli --decompress --force "${d}.tar.br"
        mkdir -p "${d}"
        pushd "${d}"
        bsdtar -x -f "../${d}.tar"
        popd
    done
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "discord/files"/* "${a}"
    local d
    for d in *.tar.br
    do
        d="${d%.tar.br}"
        if test "${d}" != "discord"
        then
            mkdir -p "${a}/modules/${d}/${d%-*}"
            cp -R "${d}/files"/* "${a}/modules/${d}/${d%-*}"
        fi
    done
    _rmmsdll "${a}"
    _lc "${a}"/*
}
