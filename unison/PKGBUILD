# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=unison
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=2.54.0
pkgrel=1
pkgdesc="Two-way file synchronizer"
url="https://www.cis.upenn.edu/~bcpierce/unison/"
arch=('any')
license=('GPL')
replaces=("app-i686-${_realname}")
provides=("${pkgbase}")
options=(!strip)
source=("unison-windows-x86_64.zip::https://github.com/bcpierce00/unison/releases/download/v${pkgver}/unison-${pkgver}-windows-x86_64.zip")
sha512sums=('8cebbb7f1c3f450708bb3c3965ef4470100754df5f10edeec3961fe372f3d48d128907a0bfa2ee91e35bc2f179715482ff36548d54dc36d6a8f75ea2acadd6e6')

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"

    cp -R "unison-${pkgver}-windows-x86_64"/* "${a}"
    mv "${a}/bin/unison"* "${a}"
    rm -R "${a}"/{bin,etc,lib,share}
}
