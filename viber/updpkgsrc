#!/bin/bash

rm "ViberSetup.exe"
curl -L "https://download.cdn.viber.com/desktop/windows/ViberSetup.exe" -o "ViberSetup.exe"
newpkgver="$(powershell -command '(Get-Item "ViberSetup.exe").VersionInfo.FileVersionRaw.ToString()')"

pkgver="$(. "PKGBUILD"; echo "${pkgver}")"
if (( "$(vercmp "${pkgver}" "${newpkgver}")" >= 0 ))
then
    echo -e "\r\e[33m skipping 'update' from v${pkgver} to v${newpkgver}\e[0m"
else
    echo -e "\r\e[32m updated from v${pkgver} to v${newpkgver}\e[0m"
    cp "PKGBUILD" "PKGBUILD.old"
    sed -i "PKGBUILD" -e "s/^pkgver=.*$/pkgver=${newpkgver}/" -e "s/^pkgrel=.*$/pkgrel=1/"
fi
