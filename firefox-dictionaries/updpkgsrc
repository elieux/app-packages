#!/usr/bin/env php
<?php
// no error handling yet

$url = "https://addons.mozilla.org/api/v5/addons/search/?app=firefox&type=dictionary&page_size=50";
$srclist = [];
while ($url) {
	$list = json_decode(file_get_contents($url));
	$url = $list->next;
	foreach ($list->results as $addon) {
		$addonname = trim(preg_replace("~[^a-z0-9_-]~i", '', transliterator_transliterate('Latin', $addon->slug)), '-_');
		echo "Found: {$addonname}-{$addon->id}.xpi\n";
		$srclist[] = "{$addonname}-{$addon->id}.xpi::https@subdir://addons.mozilla.org/firefox/downloads/latest/{$addon->id}/addon-{$addon->id}-latest.xpi";
	}
}

sort($srclist);
$srclist = ltrim(implode("\n", array_map(function($src) { return strpos($src, 'marathi-dictionary-12797.xpi') === 0 ? "        # \"{$src}\" # broken XML" : "        \"{$src}\""; }, $srclist)));
$pkgbuild = file_get_contents('PKGBUILD');
$pkgbuild = preg_replace("~source=\(.*?\)~s", "source=({$srclist})", $pkgbuild);
rename('PKGBUILD', 'PKGBUILD.old');
file_put_contents('PKGBUILD', $pkgbuild);
