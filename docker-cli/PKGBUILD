_realname=docker-cli
_dirname=docker
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=29.9.3
pkgrel=1
pkgdesc="Pack, ship and run any application as a lightweight container"
url="https://docs.docker.com/engine/reference/commandline/cli/"
arch=('any')
license=('Apache')
makedepends=()
replaces=("app-x86_64-${_realname}" "app-x86_64-docker")
conflicts=("app-x86_64-${_realname}" "app-x86_64-docker")
provides=()
options=(!strip)
source=("docker.zip::https://download.docker.com/win/static/stable/x86_64/docker-${pkgver}.zip")
sha512sums=('51741fd477e8571ae53356873316b558dfd1b3d5a3fe0f7e132f36dd1d09f4a37ed6ca8871a98880556a2911217d5fdc39979a2dd2c23fd205835ae1c198665d')
noextract=()

package() {
    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}"
    cp "docker/docker.exe" "${a}/"
}
