makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("XnShellEx64.zip::https@subdir://download.xnview.com/old_versions/XnShellEx/XnShellEx64-${pkgver}.zip"
        "XnShellEx.zip::https://download.xnview.com/old_versions/XnShellEx/XnShellEx-${pkgver}.zip")
sha512sums=('13b9a13248513fa47c4a8aa00962497da71566c264195152ef7dab663468b60446fdeb8ffb75d7878de29fee4cda51dd679434bd9a11e214350d9468a9dc6864'
            '483636cfebbb1f12f7987626fb8950ad414cd678b1b9f791eac1a5971f1e0cad74978c2bb4281562ddd65a43da24b1c32ddcfb4a1c7a9011b4a92bbfaea4bfb5')
noextract=()

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

package() {
    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}" "${a}/ShellEx64" "${a}/ShellEx"
    cp -R "XnShellEx64/XnShellEx"/* "${a}/ShellEx64"
    cp -R "XnShellEx"/* "${a}/ShellEx"
    _rmmsdll "${a}"
}
