# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=zeal
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=0.9.2
pkgrel=1
pkgdesc="An offline documentation browser for software developers"
url="https://zealdocs.org/"
arch=('any')
license=('GPL3')
makedepends=("app-lessmsi")
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("zeal-windows-x64.msi::https://github.com/zealdocs/zeal/releases/download/v${pkgver}/zeal-${pkgver}-windows-x64.msi")
sha512sums=('7d92e03d2dce2d81ed7b9222d7d45f0f4b38b9cb506aa38760f79117ae7eb80665d4a84d8e17cf3e116f5362a97145f520eea2929e7849995d0621f17b239e13')
noextract=("zeal-windows-x64.msi")

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

prepare() {
    rm -fR "zeal-windows-x64"
    /apps/lessmsi/lessmsi x "zeal-windows-x64.msi" > /dev/null
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "zeal-windows-x64/SourceDir/PFiles64/Zeal"/* "${a}"
    _rmmsdll "${a}"
}
