# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=rhino
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=1.9.1
pkgrel=1
pkgdesc="Open-source implementation of JavaScript written in Java"
url="https://developer.mozilla.org/en-US/docs/Mozilla/Projects/Rhino"
arch=('any')
license=('MPL2')
replaces=("app-i686-${_realname}")
provides=("${pkgbase}")
options=(!strip)
source=("rhino-all.jar::https://repo1.maven.org/maven2/org/mozilla/rhino-all/${pkgver}/rhino-all-${pkgver}.jar")
sha512sums=('eaa5d6f8d4441964a131e6101afdb5be755aabd2ea39210dd4492e513cb33249ed8c0b7e3b91b789ab0983639af623bbf77ca2a653cdc28b071ea7f8971b8ec0')
noextract=("rhino-all.jar")

package() {
    depends=("app-x86_64-openjdk")

    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp "rhino-all.jar" "${a}"
}
