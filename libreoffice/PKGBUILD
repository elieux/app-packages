# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=libreoffice
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=26.8.3
pkgrel=1
pkgdesc="The free office suite"
url="https://www.libreoffice.org/"
arch=('any')
license=('LGPL3' 'custom:Apache')
makedepends=("app-lessmsi")
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("LibreOffice_Win_x64.msi::https://download.documentfoundation.org/libreoffice/stable/${pkgver}/win/x86_64/LibreOffice_${pkgver}_Win_x86-64.msi")
sha512sums=('3cad1a5f97b641d5bd4e73b850fa93d427e6c5663cd92eab949c6287bf474a62f33cdeabfa0e25f646c51cdf2e1b4979e1a8f4f40211b428cd41dc5c4577cc84')
noextract=("LibreOffice_Win_x64.msi")

prepare() {
    rm -fR "LibreOffice_Win_x64"
    /apps/lessmsi/lessmsi x "LibreOffice_Win_x64.msi" > /dev/null
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "LibreOffice_Win_x64/SourceDir/LibreOffice"/* "${a}"
}
