_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=playnite
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=10.64
pkgrel=1
pkgdesc="Video game library manager"
url="https://playnite.link/"
arch=('any')
license=('MIT')
makedepends=()
replaces=("app-i686-${_realname}")
conflicts=("app-i686-${_realname}")
provides=()
options=(!strip)
source=("Playnite.7z::https@subdir://github.com/JosefNemec/Playnite/releases/download/${pkgver}/${pkgver}.7z")
sha512sums=('436b7d5063b2801427b7226e15b0f9b5d33a5a9a624c49789b47c0fb40619afcfe16300125946a7fbe2c95f507a0dd31a442948eea23a1be931f69328e9630ff')
noextract=()

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "Playnite"/* "${a}"
    _rmmsdll "${a}"

    # disable portable mode
    touch "${a}/unins000.exe"
}
