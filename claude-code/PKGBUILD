_realname=claude-code
_choconame=claude-code
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=2.1.193
pkgrel=1
pkgdesc="AI-powered coding assistant"
url="https://code.claude.com/docs/en/overview"
arch=('any')
license=('custom')
makedepends=("p7zip" "unzip")
provides=("${pkgbase}")
options=(!strip)
source=("claude.exe::https://downloads.claude.ai/claude-code-releases/${pkgver}/win32-x64/claude.exe")
sha512sums=('1e09a2c912607298fe37597c4d61c14ba1ad58469f79957b2e1e61e6197607ecdf6fbff61777a76cdb9524348c53c1d6dda2728c1b010932ee562376beaa3e51')
noextract=("claude.exe")

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp "claude.exe" "${a}"
}
