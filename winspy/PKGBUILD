_chocover() {
    # 1.7.202103022 -> 1.7
    echo "${1}" | sed -r 's/^([0-9]+)[.]([0-9]+)[.]([0-9]{9})$/\1.\2/'
}

_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=winspy++
_choconame=winspy
pkgbase="app-${_realname}"
pkgname=("app-i686-${_realname}")
epoch=1
pkgver=1.9.3
pkgrel=1
pkgdesc="Select and view the properties of any window in the system"
url="https://www.catch22.net/projects/winspy/"
arch=('any')
license=('GPL')
provides=("${pkgbase}")
options=(!strip)
source=("WinSpy_Release_x64.zip::https@subdir://github.com/strobejb/winspy/releases/download/v${pkgver}/WinSpy_Release_x64.zip")
sha512sums=('b4f30464de99c6431f6dd5807dc713b41e55d20ca008f66439c6a3a690cf4473822aa40f5990a4e6b20d6d83565ed25a734541404bbd30b704feafe270e026e4')

_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "WinSpy_Release_x64"/* "${a}"
    _lc "${a}"/*
}
