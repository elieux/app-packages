#!/bin/bash

_choconame=Firefox
_chocover() {
    # 93.0.0 -> 93.0
    # 93.0.1 -> 93.0.1
    echo "${1}" | sed -r 's/^([0-9]+)[.]0[.]0$/\1.0/'
}

set -eu

chocoxml=/tmp/apps-chocolatey.xml
if test ! -f "${chocoxml}" || (( "$(date +%s)" - "$(stat -c %Y "${chocoxml}")" > 60 * 60 ))
then
    curl -s "https://feeds.feedburner.com/chocolatey" -o "${chocoxml}"
fi

cat "${chocoxml}" | dos2unix -c mac | grep "<title>" | sed -r 's/<[^>]+>//g' | sed -r 's/[()]//g' | grep -F "${_choconame} " | while read choconame chocover
do
    if [ "${_choconame}" = "${choconame}" ]
    then
        chocover="$(echo "${chocover}" | sed -r 's/^(.+)[.]([0-9]{8})$/\1/')"
        chocover="$(_chocover "${chocover}")"
        pkgver="$(. "PKGBUILD"; echo "${pkgver}")"
        if [ "${pkgver}" != "${chocover}" ]
        then
            echo -e "\r\e[32m updated from v${pkgver} to v${chocover}\e[0m"
            cp "PKGBUILD" "PKGBUILD.old"
            sed -i "PKGBUILD" -e "s/^pkgver=.*$/pkgver=${pkgver}/" -e "s/^pkgrel=.*$/pkgrel=1/"
        else
            echo -e "\r\e[33m up to date at v${chocover}\e[0m"
        fi
    fi
done

exec php -r 'ob_start(); require($argv[1]);' -- "${BASH_SOURCE[0]}"

<?php
// no error handling yet
ob_end_clean();

$product = basename(__DIR__);
preg_match('~^pkgver=([0-9.]+)$~m', file_get_contents('PKGBUILD'), $match);
$version = $match[1];
$srclist = [];
$srclist[] = "FirefoxSetup.exe::https://ftp.mozilla.org/pub/{$product}/releases/\${pkgver}/win64/en-US/Firefox%20Setup%20\${pkgver}.exe";

$list = file_get_contents("https://ftp.mozilla.org/pub/{$product}/releases/{$version}/win64/xpi/");
preg_match_all("~xpi/([a-zA-Z-]+)[.]xpi~", $list, $matches);
foreach ($matches[1] as $lang) {
    $file = "{$lang}.xpi";
    echo "Found: {$file}\n";
    $srclist[] = "{$file}::https://ftp.mozilla.org/pub/{$product}/releases/\${pkgver}/win64/xpi/{$lang}.xpi";
}

$srclist = ltrim(implode("\n", array_map(function($src) { return "        \"{$src}\""; }, $srclist)));
$pkgbuild = file_get_contents('PKGBUILD');
$pkgbuild = preg_replace("~source=\(.*?\)~s", "source=({$srclist})", $pkgbuild);
rename('PKGBUILD', 'PKGBUILD.old');
file_put_contents('PKGBUILD', $pkgbuild);
