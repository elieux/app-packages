# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=synctrayzor
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=2.2.0
pkgrel=1
pkgdesc="Tray utility / filesystem watcher / launcher for Syncthing"
url="https://github.com/GermanCoding/SyncTrayzor"
arch=('any')
license=('MIT')
makedepends=("mingw-w64-x86_64-jq")
provides=("${pkgbase}")
options=(!strip)
source=("SyncTrayzorPortable-x64.zip::https://github.com/GermanCoding/SyncTrayzor/releases/download/v${pkgver}/SyncTrayzorPortable-x64.zip")
sha512sums=('f2f9dc102da81d523cf0287fb8c9894fcba939edca254e9835161ff612ca47921dff59e470a2551ebbe2bfc5e266a4a80c70f41fdc2029d5cbc539fcc4024e12')

_dotnet() {
    local runtimetarget="$(cat "${1}.deps.json" | /ucrt64/bin/jq -r '.runtimeTarget.name')"
    local netcore="$(cat "${1}.deps.json" | /ucrt64/bin/jq --arg runtimetarget "${runtimetarget}" -r '.targets[$runtimetarget] | keys | .[] | select(test("^runtimepack[.]Microsoft[.]NETCore[.]App[.][Rr]untime[.]win-x64/"))')"
    local windowsdesktop="$(cat "${1}.deps.json" | /ucrt64/bin/jq --arg runtimetarget "${runtimetarget}" -r '.targets[$runtimetarget] | keys | .[] | select(test("^runtimepack[.]Microsoft[.]WindowsDesktop[.]App[.][Rr]untime[.]win-x64/"))')"

    cat "${1}.deps.json" | /ucrt64/bin/jq -r --arg runtimetarget "${runtimetarget}" --arg netcore "${netcore}" --arg windowsdesktop "${windowsdesktop}" '.targets[$runtimetarget] | (.[$netcore], .[$windowsdesktop]) | (.runtime, .native) | select(.) | keys | .[]' | dos2unix | sort | uniq | (cd "$(dirname "${1}")" && xargs rm -f)

    cat "${1}.deps.json" | /ucrt64/bin/jq -r --arg runtimetarget "${runtimetarget}" --arg netcore "${netcore}" --arg windowsdesktop "${windowsdesktop}" 'del(.targets[$runtimetarget][$netcore]) | del(.targets[$runtimetarget][$windowsdesktop])' > "${1}.deps.json.tmp"
    mv -f "${1}.deps.json.tmp" "${1}.deps.json"

    cat "${1}.runtimeconfig.json" | /ucrt64/bin/jq '.runtimeOptions |= (.framework = .includedFrameworks[-1] | del(.includedFrameworks))' > "${1}.runtimeconfig.json.tmp"
    mv -f "${1}.runtimeconfig.json.tmp" "${1}.runtimeconfig.json"
}

_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

package() {
    depends=("app-syncthing")

    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "SyncTrayzorPortable-x64"/* "${a}"
    _dotnet "${a}/SyncTrayzor"
    cp "${a}/SyncTrayzor.runtimeconfig.json" "${a}/CefSharp.BrowserSubprocess.runtimeconfig.json" # Apparently defaults to stand-alone; wants 6.0.33 but that doesn't seem to matter
    _rmmsdll "${a}"
    rm "${a}/PortableInstaller.exe"

    truncate -s0 "${a}/syncthing.exe" # SyncTrayzor complains if the file is missing
    # Make non-portable again; disable updates
    sed -r -i "${a}/SyncTrayzor.dll.config" \
        -e 's~(<EnableAutostartOnFirstStart>)false~\1true~' \
        -e 's~(<Variant>)Portable~\1Installed~' \
        -e 's~(<LogFilePath>)logs~\1%APPDATA%\\SyncTrayzor\\logs~' \
        -e 's~(<ConfigurationFilePath>)data\\config.xml~\1%APPDATA%\\SyncTrayzor\\config.xml~' \
        -e 's~(<ConfigurationFileBackupPath>)data\\config-backups~\1%APPDATA%\\SyncTrayzor\\config-backups~' \
        -e 's~(<CefCachePath>)data\\cef\\cache~\1%LOCALAPPDATA%\\SyncTrayzor\\cef\\cache~' \
        -e 's~(<SyncthingPath>)data\\syncthing.exe~\1..\\syncthing\\syncthing.exe~' \
        -e 's~(<SyncthingHomePath>)data\\syncthing~\1~' \
        -e 's~(<SyncthingDenyUpgrade>)false~\1true~' \
        -e 's~(<NotifyOfNewVersions>)true~\1false~'

    _lc "${a}"/*
}
