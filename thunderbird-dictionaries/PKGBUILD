           "wordlistsourceforge-en-us-h-422912.xpi"
           "xhosa-spell-checker-46599.xpi"
           "xuxen-4020.xpi"
           "yiddish-spell-checker-yivo-222538.xpi"
           "zeiler-sutto-latin-dictionary-987788.xpi"
           "zulu-spell-checker-46490.xpi")

prepare() {
    local f
    for f in *.xpi
    do
        f="${f%%.xpi}"
        # babyish-spellchecker-557564.xpi
        # > mismatch between local and central GPF bit 11 ("UTF-8"),
        # > continuing with central flag (IsUTF8 = 1)
        # exits with 1 (a warning)
        unzip -q -o "${f}.xpi" -d "${f}" || test "$?" -eq 1
    done
}

pkgver() {
    find . -mindepth 2 -maxdepth 2 -type f -printf '%TY.%Tm.%Td\n' | sort | tail -1
}

package() {
    depends=("app-thunderbird")

    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}" "${a}/extensions"
    local f
    for f in *.xpi
    do
        f="${f%%.xpi}"
        id="$(
            cd "${f}"
            if [ -f "install.rdf" ]
            then
                python -c '
import xml.etree.ElementTree as ET
file = open("install.rdf")
desc = ET.parse(file).getroot().find("{http://www.w3.org/1999/02/22-rdf-syntax-ns#}Description")
id = desc.find("{http://www.mozilla.org/2004/em-rdf#}id")
if id is not None:
    print(id.text)
else:
    print(desc.get("{http://www.mozilla.org/2004/em-rdf#}id"))
                '
            elif [ -f "manifest.json" ]
            then
                python -c '
import json
file = open("manifest.json", encoding = "utf-8-sig")
manifest = json.load(file)
apps = manifest["browser_specific_settings"] if "browser_specific_settings" in manifest else manifest["applications"]
id = apps["gecko"]["id"]
print(id)
                '
            fi
        )"
        echo "${f}: ${id}"
        mkdir "${a}/extensions/${id}"
        cp -R "${f}"/* "${a}/extensions/${id}"
    done
}
