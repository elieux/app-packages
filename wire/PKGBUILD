# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=wire
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=3.46.5382
pkgrel=1
pkgdesc="Desktop Wire client"
url="https://www.wire.com/"
arch=('any')
license=('custom')
makedepends=("p7zip" "unzip")
replaces=("app-i686-${_realname}")
conflicts=("app-i686-${_realname}")
provides=()
options=(!strip)
source=("Wire-Setup.exe::https://wire-app.wire.com/win/prod/Wire-Setup.exe")
sha512sums=('60a739c9612cba3d35c2efb121d93271d5093f5eeb70befe645b73d6c5665603373c38d3be4d82c8d423f3ea87d7e6072a7c363789be02000294635d2420b458')
noextract=("Wire-Setup.exe")

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

prepare() {
    rm -fR "Wire-Setup.dir"
    7z x -y -bd "Wire-Setup.exe" -o"Wire-Setup.dir" > /dev/null
    unzip -q -o "Wire-Setup.dir/wire"-*-"full.nupkg" -d "wire-full"
}

pkgver() {
    powershell -command '(Get-Item "Wire-Setup.exe").VersionInfo.ProductVersion'
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "wire-full/lib/net45"/* "${a}"
    _rmmsdll "${a}"
}
