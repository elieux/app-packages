# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=dropbox
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=278.4.4020
pkgrel=1
pkgdesc="The Dropbox synchronization tool"
url="https://www.dropbox.com/"
arch=('any')
license=('custom')
makedepends=("p7zip" "python")
replaces=("app-i686-${_realname}")
conflicts=("app-i686-${_realname}")
provides=()
options=(!strip)
install="dropbox.install"
source=("DropboxOfflineInstaller.exe::https://www.dropbox.com/download?full=1&plat=win")
sha512sums=('33a59f865ef52b866361728f6905ba13eb17adde6df4875e5c8778eafe4a7479b28c326ae5d22832d6a618a7fb79c48b7488e03a6146a256736e20dd4bef6c15')
noextract=("DropboxOfflineInstaller.exe")

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

prepare() {
    7z x -y -bd "DropboxOfflineInstaller.exe" -o"DropboxOfflineInstaller.dir" > /dev/null
    7z x -y -bd "DropboxOfflineInstaller.dir"/Dropbox_app_*.x86.zip.* -o"Dropbox_app.x86" > /dev/null
}

pkgver() {
    powershell -command '(Get-Item "Dropbox_app.x86/app/Dropbox.exe").VersionInfo.FileVersion' | sed -r 's/([0-9]+[.][0-9]+[.][0-9]+)[.]0$/\1/'
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "Dropbox_app.x86/app"/* "${a}"
    rm -R "${a}/DropboxUninstaller.exe"

    # remove system DLLs
    _rmmsdll "${a}"
    mv "${a}/${pkgver}"/* "${a}"
    rm -R "${a}/${pkgver}"
    rm "${a}/${pkgver}.manifest"
    _pkgver="${pkgver}" _a="${a}" python -c '
import os

to_remove = """<dependency><dependentAssembly><assemblyIdentity type="win32" name="{0}" version="901.520.64.112" language="*"></assemblyIdentity></dependentAssembly></dependency>""".format(os.environ["_pkgver"]).encode("ascii")
f = open(os.environ["_a"] + "/Dropbox.exe", "rb+")
data = f.read()
pos = data.find(to_remove)
f.seek(pos)
f.write(b" " * len(to_remove))
f.close()
    '
    # MSYS=winsymlinks:nativestrict ln -s . "${a}/${pkgver}" # Permission denied on msys2-runtime v3.0.7
    # ( cd "${a}" && MSYS2_ARG_CONV_EXCL=* cmd /c mklink /d "${pkgver}" . ) # Works, but doesn't package correctly
}
