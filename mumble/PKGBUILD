# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=mumble
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=1.5.939
pkgrel=1
pkgdesc="Open Source, Low Latency, High Quality Voice Chat"
url="https://www.mumble.info/"
arch=('any')
license=('BSD')
makedepends=("app-lessmsi" "app-wix")
provides=("${pkgbase}")
options=(!strip)
source=("mumble_client.x64.exe::https://github.com/mumble-voip/mumble/releases/download/v${pkgver}/mumble_client-${pkgver}.x64.exe"
        "mumble_server.x64.exe::https://github.com/mumble-voip/mumble/releases/download/v${pkgver}/mumble_server-${pkgver}.x64.exe")
sha512sums=('ed0ec2a887a057456b164bf4ba9cb005ec7bda72280f76bc82ba5f963aa9576f69de7377922bb094467e7110466a982ad876f91c5e659ea0f4831e49584c2a6d'
            'e60e747d4814627af13235fe82c38f04c4be5e038119b228134ef1262cacfe50f03bff7c02e1d715e55ab07c581a95bcadb8fbb7e211b4313e6f740644c6337f')
noextract=("mumble_client.x64.exe"
           "mumble_server.x64.exe")


_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

prepare() {
    /apps/wix/dark -x "mumble_client.x64.dir" "mumble_client.x64.exe"
    pushd "mumble_client.x64.dir/AttachedContainer"
    rm -fR "mumble_client-${pkgver}.x64"
    /apps/lessmsi/lessmsi x "mumble_client-${pkgver}-x64.msi" > /dev/null
    popd

    /apps/wix/dark -x "mumble_server.x64.dir" "mumble_server.x64.exe"
    pushd "mumble_server.x64.dir/AttachedContainer"
    rm -fR "mumble_server-${pkgver}.x64"
    /apps/lessmsi/lessmsi x "mumble_server-${pkgver}-x64.msi" > /dev/null
    popd

}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "mumble_client.x64.dir/AttachedContainer/mumble_client-${pkgver}-x64/SourceDir/ProgramFiles64Folder/Mumble/client"/* "${a}"
    cp -R "mumble_server.x64.dir/AttachedContainer/mumble_server-${pkgver}-x64/SourceDir/ProgramFiles64Folder/Mumble/server"/* "${a}"
    _rmmsdll "${a}"
    _lc "${a}"/*
}
