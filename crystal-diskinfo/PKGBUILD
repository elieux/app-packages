_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

_realname=crystaldiskinfo
_dirname=crystal
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=9.9.5
pkgrel=1
pkgdesc="A disk utility (Crystal Dew World)"
url="https://crystalmark.info/software/CrystalDiskInfo/index-e.html"
arch=('any')
license=('MIT')
makedepends=()
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("CrystalDiskInfo.zip::https@subdir://downloads.sourceforge.net/crystaldiskinfo/CrystalDiskInfo${pkgver//./_}.zip")
sha512sums=('c86661cc4441cb028d655a5f65c277a8f84e4272170c7d5d7657c6877fc8742ea917d97ce55abfad07cc9f342cdc90fe36095b07a41660dde4582210a10aeb31')
noextract=()

package() {
    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}"
    cp -R "CrystalDiskInfo"/* "${a}"
    rm "${a}/DiskInfo32.exe" "${a}"/DiskInfoA*.exe
    mv "${a}/DiskInfo64.exe" "${a}/CrystalDiskInfo.exe"
    mv "${a}/License" "${a}/CdiLicense"
    mv "${a}/ReadMe.txt" "${a}/CdiReadMe.txt"
}
