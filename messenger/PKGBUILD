# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=messenger
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=2.0.9
pkgrel=2
pkgdesc="Beautiful desktop client for Facebook Messenger. Chat without being distracted by your feed or notifications."
url="https://github.com/Aluxian/Facebook-Messenger-Desktop/"
arch=('any')
license=('MIT')
makedepends=("unzip")
replaces=("app-i686-${_realname}")
conflicts=("app-i686-${_realname}")
provides=()
options=(!strip)
source=("messengerfordesktop-full.nupkg::https://github.com/aluxian/Messenger-for-Desktop/releases/download/v${pkgver}/messengerfordesktop-${pkgver}-full.nupkg")
sha512sums=('4288e4a24ff6776890eac8b4810f94f11a90ee67a5b16b92c06834731f7ee9b449e66cb736b6063c0e02448183f105d4922b004ab8e779569d28a6729a4b6d52')
noextract=("messengerfordesktop-full.nupkg")

prepare() {}
    unzip -q -o "messengerfordesktop-full.nupkg" -d "messengerfordesktop-full"
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "messengerfordesktop-full/lib/net45"/* "${a}"
    mv "${a}/messenger%20for%20desktop.exe" "${a}/messenger.exe"
}
