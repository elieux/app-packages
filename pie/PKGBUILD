_realname=pie
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=1.6.0
pkgrel=1
pkgdesc="The PHP Installer for Extensions"
url="https://php.github.io/pie/"
arch=('any')
license=('BSD-3-Clause')
makedepends=()
replaces=()
conflicts=()
provides=()
options=(!strip)
source=("pie-Windows-X64.exe::https://github.com/php/pie/releases/download/${pkgver}/pie-Windows-X64.exe"
        "pie.phar::https://github.com/php/pie/releases/download/${pkgver}/pie.phar")
sha512sums=('c4817c779c021cb4628c88b9cdef8b1b6aeb3a08f84bd978e071e605813509fd4b3d6146c7d45a646a5dd57edcdc807c8739df60b0dcae9ae5bd62716fcfc877'
            '86a7f615df814aadae86ea850dd6221e489f168585e74dfdbc411d568650f29d5b86f4b326fbfe57ad5288649ba3b0b6a7fa930175fae276c65657a098ce0569')
noextract=("pie-Windows-X64.exe"
           "pie.phar")

package() {
    depends=("app-php")

    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp "pie-Windows-X64.exe" "${a}/pie.exe"
    cp "pie.phar" "${a}"
}
