_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=vscode
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=1.146.0
pkgrel=1
pkgdesc="Editor for building and debugging modern web and cloud applications"
url="https://code.visualstudio.com/"
arch=('any')
license=('custom')
makedepends=()
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
install="vscode.install"
source=("VSCode-win32-x64.zip::https@subdir://code.visualstudio.com/sha/download?build=stable&os=win32-x64-archive")
sha512sums=('a11afacbace5b72d79f867c3984fe0e5602c7a840d8bdd160d761d4c580998ee59f513910709ff23c3e8c3e81384ae137c79d96b3ab497dc9b6ebf605cdf76fb')
noextract=()

_rmmsdll() {
    local ms

    ms=("msvbvm[0-9]+"
        "ucrtbase"
        "mfcm?[0-9]+[a-z]+"
        "msvc[rp][0-9]+(_([0-9]|codecvt_ids|atomic_wait))?"
        "vc([ao]mp|corlib|runtime)[0-9]+(_([0-9]|threads))?"
        "concrt[0-9]+"
        "pgort[0-9]+"
        "api-ms-win-[0-9a-z-]+")
    find "${1}" -iname '*.dll' | grep -Eif <(for m in "${ms[@]}"; do echo "/${m}[.]dll$"; done) | xargs -r rm
}

pkgver() {
    powershell -command '(Get-Item "VSCode-win32-x64/Code.exe").VersionInfo.ProductVersion'
}

package() {
    depends=("coreutils" "grep")

    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"

    # cp can otherwise fail with "cannot create regular file" due to the runtime's extension magic
    mkdir "${a}/bin" "${a}/bin/copilot-shim"
    cp "VSCode-win32-x64/bin/code" "${a}/bin"
    cp "VSCode-win32-x64/bin/copilot-shim/copilot" "${a}/bin/copilot-shim"
    cp -nR "VSCode-win32-x64"/* "${a}"

    local hash="$(grep "${a}/Code.VisualElementsManifest.xml" -P --only-matching -e '(?<=Logo=")[0-9a-f]{10}(?=\\)' | head -1)"
    mv "${a}/${hash}"/* "${a}"
    rm -R "${a}/${hash}"

    _rmmsdll "${a}"
}
