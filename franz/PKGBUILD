# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=franz
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=5.11.0
pkgrel=1
pkgdesc="Franz is a free messaging app and combines chat & messaging services into one application"
url="https://meetfranz.com/"
arch=('any')
license=('custom')
makedepends=("p7zip")
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("franz-setup.exe::https://github.com/meetfranz/franz/releases/download/v${pkgver}/franz-setup-${pkgver}.exe")
sha512sums=('cf9700e5acebd036b840fb97f0591f6709fb787d0fd2ea4a3ccf032b5cf5aba67935b9170eff71d03f6b880bf91918f969d5930c77046a7de411536a9bae5e82')
noextract=("franz-setup.exe")

prepare() {
    7z x -y -bd "franz-setup.exe" -o"franz-setup.dir" > /dev/null
    7z x -y -bd "franz-setup.dir"/'$PLUGINSDIR'/"app-64.7z" -o"app-64" > /dev/null
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "app-64"/* "${a}"
}
