_realname=teamspeak-server
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=3.13.9
pkgrel=1
pkgdesc="A proprietary VoIP conference software"
url="https://www.teamspeak.com/"
arch=('any')
license=('custom')
makedepends=()
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("teamspeak3-server_win64.zip::https://files.teamspeak-services.com/releases/server/${pkgver}/teamspeak3-server_win64-${pkgver}.zip")
sha512sums=('29505a8470db67c4a485f2e1ff1bf7f7555774588846d7a18536fd8c78cf3999a9239c4251db5858f5c5b9d891fe9fd9cc8d1795225498825f817c3c58446f2a')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "teamspeak3-server_win64"/* "${a}"
    mv "${a}/redist"/* "${a}"
    rm -R "${a}/redist"
}
