# without user-agent, it redirects to localhost
DLAGENTS=('https::/usr/bin/curl -qb "" -fLC - -H user-agent:Mozilla -o %o %u')

_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=httpd
_realver=261002
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=2.4.69
pkgrel=2
pkgdesc="A high performance Unix-based HTTP server"
url="https://httpd.apache.org/"
arch=('any')
license=('Apache')
makedepends=("curl")
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("httpd-win64-VS18.zip::https@subdir://www.apachelounge.com/download/VS18/binaries/httpd-${pkgver}-${_realver}-win64-VS18.zip")
sha512sums=('2fad746a77cbb02966543926e6c1c6c433369e3123ed85b3ee7e8ab994ceaebe6b584bb2b766e5f46a396105d34024b659df1da1c6c5da07a9197744bab3faf4')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "httpd-win64-VS18"/* "${a}"
    mv "${a}/ReadMe.txt" "${a}/ReadMe_ApacheLounge.txt"
    rm "${a}/-- Win64 VS18  --"
    mv "${a}/Apache24"/* "${a}"
    rm -R "${a}/Apache24" "${a}/conf/original" "${a}/logs"
}
