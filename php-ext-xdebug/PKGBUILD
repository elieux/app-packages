# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=php-ext-xdebug
_dirname=php
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=3.5.3
pkgrel=1
pkgdesc="PHP debugging extension"
url="https://xdebug.org/"
arch=('any')
license=('GPL')
provides=("${pkgbase}")
options=(!strip)
source=("php_xdebug-8.5-nts-vs17-x86_64.dll::https://xdebug.org/files/php_xdebug-${pkgver}-8.5-nts-vs17-x86_64.dll")
sha512sums=('519fb2521bfdddb7fe2b3c60308423eb177fcf6c57ab2202311183e3b36c189a68f81ab9e59f3165ceeca32fe6473dcfdefc3e57cc0ecb37ec4a3c9a6ddaf116')

package() {
    depends=("app-x86_64-php>=1~8.5.0" "app-x86_64-php<1~8.6.0")

    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}/ext"
    cp "php_xdebug-8.5-nts-vs17-x86_64.dll" "${a}/ext/php_xdebug.dll"
}
