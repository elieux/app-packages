_realname=gradle
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=9.9.1
pkgrel=1
pkgdesc="Powerful build system for the JVM"
url="https://gradle.org/"
arch=('any')
license=('Apache')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("gradle-all.zip::https://services.gradle.org/distributions/gradle-${pkgver}-all.zip")
sha512sums=('d7785ec8c82d75238ebf49125f2208c3751215ed017c91d3171099e775a0e4b39bf13bc92356803ab6354447442e16649d29e718202064ca74b3b2d0ee6dcf3e')
noextract=()

package() {
    depends=("app-openjdk>=2~21")

    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "gradle-${pkgver}"/* "${a}"
}
