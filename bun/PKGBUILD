# Maintainer: David Macek <david.macek.0@gmail.com>

_realname=bun
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=1.4.5
pkgrel=1
pkgdesc="An all-in-one toolkit for JavaScript and TypeScript apps"
url="https://bun.sh/"
arch=('any')
license=('MIT')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("bun-windows-x64.zip::https://github.com/oven-sh/bun/releases/download/bun-v${pkgver}/bun-windows-x64.zip")
sha512sums=('3783043c75d3d5b849ff452146603bba15fb4b04c75243b69cecbc9a1b3bffff4faafbe738e61e1a270518d55719d73cc858e49f32e5b37a8dec84c2b52c7495')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp "bun-windows-x64"/* "${a}"
    ln "${a}/bun.exe" "${a}/bunx.exe"
}
