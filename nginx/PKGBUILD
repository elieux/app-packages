_realname=nginx
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=1.31.10
pkgrel=1
pkgdesc="Lightweight HTTP server and IMAP/POP3 proxy server"
url="https://nginx.org/"
arch=('any')
license=('custom')
makedepends=()
replaces=("app-i686-${_realname}")
conflicts=("app-i686-${_realname}")
provides=()
options=(!strip)
source=("nginx.zip::https://nginx.org/download/nginx-${pkgver}.zip")
sha512sums=('f893a660984daaff149814080375768e72c32cedb8d42c51f2005533ea044a5c269e48ee956ba59f22e2928be177d251eec543c1ed427c9936bad06a05f2037e')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "nginx-${pkgver}"/* "${a}"
    rm -R "${a}"/{logs,temp}
}
