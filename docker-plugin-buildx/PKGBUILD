_realname=docker-plugin-buildx
_dirname=docker
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=0.39.0
pkgrel=1
pkgdesc="Extended build capabilities with BuildKit"
url="https://docs.docker.com/build/"
arch=('any')
license=('Apache')
makedepends=()
replaces=("app-x86_64-${_realname}")
conflicts=("app-x86_64-${_realname}")
provides=()
options=(!strip)
source=("buildx.windows-amd64.exe::https://github.com/docker/buildx/releases/download/v${pkgver}/buildx-v${pkgver}.windows-amd64.exe")
sha512sums=('8a8c2120d54ab506f7a36b0e5a6b022dc98becd40f5e8c0cb35be89e599fff272a4a60ce88211d5cf0a9d48b43b7e76c321dd712da87a52d6c21bab1a0812258')
noextract=("buildx.windows-amd64.exe")

package() {
    depends=("app-docker-cli")

    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}/cli-plugins"
    cp "buildx.windows-amd64.exe" "${a}/cli-plugins/docker-buildx.exe"
}
