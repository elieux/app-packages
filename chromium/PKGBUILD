_realname=chromium
_realver=1717349
pkgbase="app-${_realname}"
pkgname=("app-${_realname}")
epoch=2
pkgver=157.0.8103.79
pkgrel=1
pkgdesc="The open-source project behind Google Chrome, an attempt at creating a safer, faster, and more stable browser"
url="https://www.chromium.org/Home"
arch=('any')
license=('BSD')
makedepends=()
replaces=("app-x86_64-${_realname}" "app-i686-${_realname}")
conflicts=("app-x86_64-${_realname}" "app-i686-${_realname}")
provides=()
options=(!strip)
source=("chrome.7z::https://github.com/Hibbiki/chromium-win64/releases/download/v${pkgver}-r${_realver}/chrome.7z")
sha512sums=('c24ff69e6acf8510bf4d7ba483224c7b8aa553196a89bd3b6c8ed06fe7aca90b60461e9a335e2f83a3d3e88e12c1da8111a02d78b79d3b07b643789ae8a9628b')
noextract=()

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "Chrome-bin"/* "${a}"
    mv "${a}/${pkgver}"/* "${a}"
    rm -R "${a}/${pkgver}"
}
