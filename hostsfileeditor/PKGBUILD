_extract_subdir() {
    local _file="$(get_filename "${1}")"
    local _dir="${_file%.*}"
    if type bsdtar | head -1 | grep -q 'is a function'
    then
        local _original_bsdtar="$(type bsdtar | tail +2)"
    fi
    bsdtar() {
        local _extra_args=()
        if [ "${1}" = "-xf" ]
        then
            mkdir -p "${_dir}"
            _extra_args=(-C "${_dir}")
        fi
        /usr/bin/bsdtar "${_extra_args[@]}" "${@}"
    }
    extract_file "${_file}"
    unset -f bsdtar
    eval "${_original_bsdtar}"
}

extract_https@subdir() {
    _extract_subdir "${@}"
}

download_https@subdir() {
    download_file "${1/@subdir:/:}"
}

_realname=hostsfileeditor
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=1.5.2
pkgrel=1
pkgdesc="Easily edit and manage the hosts file"
url="https://hostsfileeditor.com/"
arch=('any')
license=('GPL3')
replaces=("app-i686-${_realname}")
provides=("${pkgbase}")
options=(!strip)
source=("HostsFileEditor.zip::https@subdir://github.com/scottlerch/HostsFileEditor/releases/download/v${pkgver}/HostsFileEditor-${pkgver}-x64.zip")
sha512sums=('a7cb61a7fa84a64103b2b06a347aeeaa54fd708599239a572b8944a4c13649aa66a185516a07da267fa0c818d9a63cc220bb6b150e1f24741b6a52a73907ada4')

_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

package() {
    local a="${pkgdir}/apps/${_realname}"
    mkdir -p "${a}"
    cp -R "HostsFileEditor"/* "${a}"
    _lc "${a}"/*
}
