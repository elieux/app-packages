# Maintainer: David Macek <david.macek.0@gmail.com>

_dirname=xdebug-dbgp-tools
_realname=xdebug-dbgp-client
pkgbase="app-${_realname}"
pkgname=("app-x86_64-${_realname}")
epoch=1
pkgver=0.6.2 # determined by running the .exe
pkgrel=1
pkgdesc="DBGp client from Xdebug"
url="https://xdebug.org/docs/dbgpClient"
arch=('any')
license=('unknown')
conflicts=("xdebug-dbgp-tools")
provides=("${pkgbase}")
options=(!strip)
source=("dbgpClient.exe::https://xdebug.org/files/binaries/dbgpClient.exe")
sha512sums=('88a388c652a53ada63047eaeca15b98eed09565e2444085cf252affada724c118a6a45060265a3d4b487b7a81b7f33c4dd89cc8c5b943a219b99af730860524f')

_lc() {
    local d f n

    for f in "${@}"
    do
        d="$(dirname "${f}")"
        f="$(basename "${f}")"
        n="$(echo "${f}" | tr 'A-Z' 'a-z')"
        if test "${f}" != "${n}"
        then
            mv "${d}/${f}" "${d}/${n}"
        fi
    done
}

package() {
    local a="${pkgdir}/apps/${_dirname}"
    mkdir -p "${a}"
    cp "dbgpClient.exe" "${a}"
    _lc "${a}"/*
}
